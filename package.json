  },
  "devDependencies": {
    "@types/chrome": "0.1.24",
    "@types/jsdom": "21.1.7",
    "esbuild": "0.25.5",
    "fake-indexeddb": "6.0.1",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "prettier": "3.5.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
