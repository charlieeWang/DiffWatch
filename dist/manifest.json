{
  "manifest_version": 3,
  "name": "DiffWatch",
  "version": "1.0.1",
  "description": "於專用背景分頁比較選定 DOM 文字、連結與圖片網址，所有資料留在本機。",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "notifications",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "incognito": "not_allowed"
}